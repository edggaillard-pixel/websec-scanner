<!doctype html>
<html lang="{{ lang }}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ labels.title }}</title>
<style>
  :root {
    --bg: #0f1419; --panel: #1a212b; --panel-2: #222b38; --text: #e6edf3;
    --muted: #8b98a9; --border: #2d3745; --accent: #4c9fff;
    --crit: #b4232a; --high: #d9641e; --med: #c9a227; --low: #3f7cad; --info: #5a6b7d;
    --ok: #2ea043;
  }
  * { box-sizing: border-box; }
  body {
    margin: 0; background: var(--bg); color: var(--text);
    font: 15px/1.55 -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
  }
  .wrap { max-width: 980px; margin: 0 auto; padding: 32px 20px 64px; }
  header h1 { margin: 0 0 4px; font-size: 24px; letter-spacing: .2px; }
  .meta { color: var(--muted); font-size: 13px; }
  .meta code { color: var(--accent); }
  .disclaimer {
    margin: 18px 0 28px; padding: 10px 14px; font-size: 13px; color: var(--muted);
    border: 1px solid var(--border); border-left: 3px solid var(--accent);
    border-radius: 6px; background: var(--panel);
  }
  .target {
    background: var(--panel); border: 1px solid var(--border); border-radius: 10px;
    margin: 22px 0; overflow: hidden;
  }
  .target > .head {
    display: flex; flex-wrap: wrap; align-items: center; gap: 16px;
    padding: 18px 20px; border-bottom: 1px solid var(--border); background: var(--panel-2);
  }
  .target .url { font-size: 17px; font-weight: 600; word-break: break-all; flex: 1 1 auto; }
  .badge {
    display: inline-block; padding: 5px 12px; border-radius: 999px;
    font-weight: 700; font-size: 13px; letter-spacing: .5px; color: #fff;
  }
  .risk-low { background: var(--ok); }
  .risk-medium { background: var(--med); color:#1a1a1a; }
  .risk-high { background: var(--crit); }
  .gauge { font-size: 13px; color: var(--muted); }
  .gauge strong { color: var(--text); font-size: 15px; }
  .counts { display: flex; gap: 8px; flex-wrap: wrap; padding: 12px 20px; border-bottom: 1px solid var(--border); }
  .pill {
    font-size: 12px; padding: 3px 9px; border-radius: 6px; border: 1px solid var(--border);
    color: var(--text); background: var(--bg);
  }
  .pill .n { font-weight: 700; }
  .dot { display:inline-block; width:9px; height:9px; border-radius:50%; margin-right:6px; vertical-align: middle; }
  .d-critical { background: var(--crit); } .d-high { background: var(--high); }
  .d-medium { background: var(--med); } .d-low { background: var(--low); } .d-info { background: var(--info); }
  table { width: 100%; border-collapse: collapse; }
  thead th {
    text-align: left; font-size: 12px; text-transform: uppercase; letter-spacing: .6px;
    color: var(--muted); padding: 10px 20px; border-bottom: 1px solid var(--border);
  }
  tbody td { padding: 14px 20px; border-bottom: 1px solid var(--border); vertical-align: top; }
  tbody tr:last-child td { border-bottom: none; }
  .sev {
    font-weight: 700; font-size: 12px; padding: 3px 8px; border-radius: 5px; color: #fff; white-space: nowrap;
  }
  .sev-critical { background: var(--crit); } .sev-high { background: var(--high); }
  .sev-medium { background: var(--med); color:#1a1a1a; } .sev-low { background: var(--low); } .sev-info { background: var(--info); }
  .f-title { font-weight: 600; }
  .f-desc { color: var(--text); margin: 4px 0 8px; }
  .f-reco { color: var(--muted); font-size: 13.5px; }
  .f-reco b { color: var(--text); font-weight: 600; }
  .refs { margin-top: 8px; }
  .ref { font-size: 11.5px; color: var(--accent); border: 1px solid var(--border); padding: 1px 7px; border-radius: 5px; margin-right: 6px; }
  details.evidence { margin-top: 8px; }
  details.evidence summary { cursor: pointer; color: var(--muted); font-size: 12.5px; }
  pre.evidence {
    margin: 6px 0 0; padding: 10px; background: var(--bg); border: 1px solid var(--border);
    border-radius: 6px; font-size: 12px; overflow-x: auto; color: var(--muted);
  }
  .empty { padding: 20px; color: var(--muted); }
  .errs { padding: 10px 20px; color: #d9a441; font-size: 13px; border-bottom: 1px solid var(--border); }
  footer { margin-top: 32px; color: var(--muted); font-size: 12px; text-align: center; }
</style>
</head>
<body>
<div class="wrap">
  <header>
    <h1>{{ labels.title }}</h1>
    <div class="meta">
      {{ labels.generated }}: {{ generated }} &nbsp;·&nbsp;
      {{ labels.scanner }}: <code>websec-scanner {{ result.scanner_version }}</code> &nbsp;·&nbsp;
      {{ labels.duration }}: {{ result.duration_s }}s
    </div>
  </header>

  <div class="disclaimer">{{ labels.disclaimer }}</div>

  {% for t in result.targets %}
  <section class="target">
    <div class="head">
      <div class="url">{{ t.target }}</div>
      {% if t.score %}
      <div class="gauge">{{ labels.score }}: <strong>{{ t.score.score_0_100 }}</strong>/100</div>
      <span class="badge risk-{{ t.score.level }}">{{ labels.overall }}: {{ labels.risk[t.score.level] }}</span>
      {% endif %}
    </div>

    {% if t.score %}
    <div class="counts">
      {% for sev in severity_order %}
      <span class="pill"><span class="dot d-{{ sev }}"></span>{{ labels.sev[sev] }}: <span class="n">{{ t.score.counts[sev] }}</span></span>
      {% endfor %}
    </div>
    {% endif %}

    {% if t.errors %}
    <div class="errs">{{ labels.errors }}: {{ t.errors | join('; ') }}</div>
    {% endif %}

    {% if t.findings %}
    <table>
      <thead>
        <tr>
          <th style="width:90px">{{ labels.severity }}</th>
          <th>{{ labels.finding }}</th>
        </tr>
      </thead>
      <tbody>
        {% for f in t.findings %}
        <tr>
          <td><span class="sev sev-{{ f.severity }}">{{ labels.sev[f.severity] }}</span></td>
          <td>
            <div class="f-title">{{ f.title }}</div>
            <div class="f-desc">{{ f.description }}</div>
            <div class="f-reco"><b>{{ labels.recommendation }}:</b> {{ f.recommendation }}</div>
            <div class="refs">
              {% if f.owasp %}<span class="ref">OWASP {{ f.owasp }}</span>{% endif %}
              {% if f.cwe %}<span class="ref">{{ f.cwe }}</span>{% endif %}
            </div>
            {% if f.evidence %}
            <details class="evidence">
              <summary>{{ labels.evidence }}</summary>
              <pre class="evidence">{{ f.evidence | tojson(indent=2) }}</pre>
            </details>
            {% endif %}
          </td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
    {% else %}
    <div class="empty">{{ labels.no_findings }}</div>
    {% endif %}
  </section>
  {% endfor %}

  <footer>websec-scanner · {{ result.scanner_version }}</footer>
</div>
</body>
</html>
